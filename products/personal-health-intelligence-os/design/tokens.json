{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Personal Health Intelligence OS",
  "version": "0.1.0",
  "color": {
    "canvas": "#F5F3ED",
    "surface": "#FFFFFF",
    "ink": "#203B36",
    "muted": "#566962",
    "forest": "#244D40",
    "forestLight": "#E5EDE5",
    "clay": "#A34F3C",
    "clayLight": "#F7E8E2",
    "rule": "#D7DED5",
    "focus": "#7C3C20",
    "warning": "#765200"
  },
  "type": {
    "display": "Georgia, 'Times New Roman', serif",
    "body": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "ui-monospace, 'Cascadia Code', monospace",
    "bodyPx": 16,
    "captionPx": 13,
    "lineHeight": 1.5
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "card": 20, "input": 10, "pill": 100 },
  "layout": { "maximumWidthPx": 1320, "mobileBreakpointPx": 700, "minimumTouchTargetPx": 44 },
  "chart": {
    "sleep": "#244D40",
    "energy": "#A34F3C",
    "missing": "gap",
    "clinicalColorThresholds": false,
    "legendRequired": true,
    "unitsRequired": true
  },
  "motion": { "purpose": "state feedback only", "reducedMotion": "disable transition", "durationMs": 120 }
}
