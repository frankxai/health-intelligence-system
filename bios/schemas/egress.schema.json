{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bios.health/schemas/egress.v0.1.json",
  "title": "BIOS Egress Policy",
  "description": "Sensitivity class mapped to model tier. Redaction is a compile step with tests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "schema_version",
    "household_id",
    "subject_id",
    "default_deny",
    "rules",
    "updated_at"
  ],
  "properties": {
    "policy_id": { "type": "string", "pattern": "^egress_[A-Za-z0-9_-]+$" },
    "schema_version": { "const": "0.1.0" },
    "household_id": { "type": "string" },
    "subject_id": { "type": "string" },
    "default_deny": { "type": "boolean", "const": true },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sensitivity_class", "allowed_tiers", "redaction_profile"],
        "properties": {
          "sensitivity_class": {
            "enum": ["public", "personal", "clinical", "genomic"]
          },
          "allowed_tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["local", "tee_or_venice", "frontier", "none"]
            },
            "uniqueItems": true
          },
          "redaction_profile": {
            "enum": ["none", "identifiers_only", "clinical_strip", "aggregate_only", "block"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "steward_id": { "type": "string" }
  }
}
