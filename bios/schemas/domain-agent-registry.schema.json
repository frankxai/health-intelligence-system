{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bios.health/schemas/domain-agent-registry.v0.1.json",
  "title": "BIOS Bounded Public Domain-Agent Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "schema_version", "last_reviewed", "advice_mode", "reserved_name_denylist", "prohibited_actions", "agents"],
  "properties": {
    "registry_id": { "type": "string", "pattern": "^registry_[A-Za-z0-9_-]+$" },
    "schema_version": { "const": "0.1.0" },
    "last_reviewed": { "type": "string", "format": "date" },
    "advice_mode": { "const": "education_and_organization_only" },
    "reserved_name_denylist": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["vitalis", "velora"] }
    },
    "prohibited_actions": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "agents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "pack_id", "canonical_label", "brand_status", "domain", "purpose", "allowed_actions", "must_not", "data_classes_read", "evidence_tiers_may_cite", "implementation_status"],
        "properties": {
          "agent_id": { "type": "string", "pattern": "^agent_[A-Za-z0-9_-]+$" },
          "pack_id": { "type": "string", "minLength": 1 },
          "canonical_label": { "type": "string", "minLength": 1 },
          "brand_status": { "const": "generic_public" },
          "domain": { "enum": ["health_stewardship", "movement_training", "martial_arts_movement", "culinary_botanicals", "complementary_practice_education"] },
          "purpose": { "type": "string", "minLength": 20 },
          "allowed_actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "must_not": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
          "data_classes_read": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "evidence_tiers_may_cite": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["A", "B", "C", "D"] } },
          "implementation_status": { "const": "registry_only" }
        }
      }
    }
  }
}
