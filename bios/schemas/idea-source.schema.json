{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bios.health/schemas/idea-source.v0.1.json",
  "title": "BIOS Idea Source",
  "description": "Bibliographic discovery metadata only. An idea source cannot support user-facing advice until its claims resolve to primary or guideline evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["idea_source_id", "schema_version", "title", "creators", "kind", "publisher", "publication_year", "authority_url", "discovery_tier", "content_policy", "claim_admission_rule", "retrieved_on"],
  "properties": {
    "idea_source_id": { "type": "string", "pattern": "^idea_[A-Za-z0-9_-]+$" },
    "schema_version": { "const": "0.1.0" },
    "title": { "type": "string", "minLength": 1 },
    "creators": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "kind": { "enum": ["book", "podcast", "video", "newsletter", "popular_article"] },
    "publisher": { "type": "string" },
    "publication_year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
    "isbn": { "type": "string" },
    "authority_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "discovery_tier": { "const": "idea_source_only" },
    "content_policy": { "const": "bibliographic_metadata_only_no_copyrighted_full_text" },
    "claim_admission_rule": { "const": "resolve_to_primary_systematic_review_or_guideline_before_user_facing_advice" },
    "notes": { "type": "string", "maxLength": 500, "pattern": "^[^\\r\\n]*$" },
    "retrieved_on": { "type": "string", "format": "date" }
  }
}
