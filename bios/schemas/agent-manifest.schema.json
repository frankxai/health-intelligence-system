{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bios.health/schemas/agent-manifest.v0.1.json",
  "title": "BIOS Agent Manifest",
  "description": "Unmanifested agents do not load.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "schema_version",
    "title",
    "reads",
    "writes",
    "evidence_tiers_may_cite",
    "escalation_triggers",
    "tools_required"
  ],
  "properties": {
    "agent_id": { "type": "string", "pattern": "^agent_[A-Za-z0-9_-]+$" },
    "schema_version": { "const": "0.1.0" },
    "title": { "type": "string" },
    "reads": {
      "type": "array",
      "items": {
        "enum": ["public", "personal", "clinical", "genomic"]
      },
      "uniqueItems": true
    },
    "writes": {
      "type": "array",
      "items": {
        "enum": ["none", "observe", "protocol_run", "export", "consent"]
      },
      "uniqueItems": true
    },
    "evidence_tiers_may_cite": {
      "type": "array",
      "items": {
        "enum": ["A", "B", "C", "D"]
      },
      "uniqueItems": true
    },
    "escalation_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "tools_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "must_not": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
