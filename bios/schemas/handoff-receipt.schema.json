{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bios.health/schemas/handoff-receipt.v0.1.json",
  "title": "BIOS Local Handoff Audit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "schema_version",
    "generated_at",
    "household_id",
    "subject_id",
    "recipient",
    "processor",
    "purpose",
    "target_tier",
    "included_event_ids",
    "included_protocol_run_ids",
    "consent_ids",
    "egress_policy_sha256",
    "content_sha256",
    "signature"
  ],
  "properties": {
    "receipt_id": { "type": "string", "pattern": "^receipt_[A-Za-z0-9_-]+$" },
    "schema_version": { "const": "0.1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "household_id": { "type": "string", "pattern": "^hh_[A-Za-z0-9_-]+$" },
    "subject_id": { "type": "string", "pattern": "^sub_[A-Za-z0-9_-]+$" },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipient_id", "kind"],
      "properties": {
        "recipient_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["self", "steward", "household_member", "clinician", "local_agent", "frontier_model", "commons", "backup_target"] }
      }
    },
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processor_id", "kind"],
      "properties": {
        "processor_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["local_runtime", "local_human_tool", "hosted_model", "backup_service"] }
      }
    },
    "purpose": { "const": "clinician_handoff" },
    "target_tier": { "enum": ["local", "tee_or_venice", "frontier"] },
    "included_event_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" } },
    "included_protocol_run_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" } },
    "consent_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^consent_[A-Za-z0-9_-]+$" } },
    "egress_policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "hmac-sha256" },
        "key_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
