{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bios.health/schemas/protocol.v0.1.json",
  "title": "BIOS Protocol",
  "description": "Declarative n-of-1 intervention spec. Protocols are to health what repos are to code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "schema_version",
    "title",
    "release_status",
    "domain_pack",
    "class",
    "hypothesis",
    "intervention",
    "timing",
    "duration",
    "measurement_plan",
    "stop_conditions",
    "contraindications",
    "claim_ids",
    "evidence_floor",
    "jurisdiction_flags",
    "safety",
    "review_gate"
  ],
  "properties": {
    "protocol_id": { "type": "string", "pattern": "^proto_[A-Za-z0-9_-]+$" },
    "schema_version": { "const": "0.1.0" },
    "title": { "type": "string", "minLength": 3, "maxLength": 160 },
    "release_status": { "enum": ["draft_synthetic", "reviewed"] },
    "version": { "type": "string", "minLength": 1 },
    "domain_pack": {
      "enum": ["circadian", "breath", "nutrition", "tea", "mind", "movement", "sleep", "custom"]
    },
    "class": {
      "enum": [
        "ordinary_wellness",
        "habit_tracking",
        "education",
        "clinician_supervised_only",
        "jurisdiction_restricted"
      ]
    },
    "hypothesis": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "steps"],
      "properties": {
        "summary": { "type": "string", "minLength": 5, "maxLength": 500 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "dose_descriptor": {
          "type": "string",
          "description": "Amount language is permitted only after the protocol passes the evidence, safety, clinical, and release gates; shipped drafts must not contain actionable guidance."
        },
        "materials": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor"],
      "properties": {
        "anchor": {
          "enum": [
            "upon_waking",
            "morning",
            "midday",
            "afternoon",
            "evening",
            "pre_sleep",
            "with_meals",
            "circadian_phase",
            "as_needed_non_urgent",
            "fixed_clock"
          ]
        },
        "clock_local": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" },
        "phase_note": { "type": "string", "maxLength": 500 },
        "frequency": { "type": "string", "maxLength": 200 }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days"],
      "properties": {
        "days": { "type": "integer", "minimum": 1, "maximum": 366 },
        "washout_days": { "type": "integer", "minimum": 0, "maximum": 90 },
        "min_adherence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "measurement_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "method", "cadence"],
        "properties": {
          "metric": { "type": "string" },
          "method": {
            "enum": ["self_report", "photo", "wearable_rollup", "timer", "journal", "scale_1_10"]
          },
          "cadence": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "expected_effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": { "enum": ["improve", "reduce", "stabilize", "explore"] },
        "subjective_window_days": { "type": "integer", "minimum": 1 },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "contraindications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "label", "severity", "action", "match_terms"],
        "properties": {
          "condition_id": { "type": "string", "pattern": "^contra_[A-Za-z0-9_-]+$" },
          "label": { "type": "string", "minLength": 3, "maxLength": 300 },
          "severity": { "enum": ["review", "high", "critical"] },
          "action": {
            "enum": [
              "block_pending_human_review",
              "block_and_require_verified_signed_clearance",
              "permanent_runtime_block"
            ]
          },
          "match_terms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3 }
          }
        }
      }
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^claim_[A-Za-z0-9_-]+$" },
      "uniqueItems": true
    },
    "evidence_floor": {
      "enum": ["A", "B", "C", "D", "E", "Q"]
    },
    "jurisdiction_flags": {
      "type": "array",
      "items": {
        "enum": [
          "none",
          "culinary_only",
          "supplement_label_varies",
          "controlled_substance_check",
          "clinician_required",
          "age_restricted"
        ]
      },
      "uniqueItems": true
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_diagnosis",
        "not_prescription",
        "emergency_route",
        "medical_functionality_disabled",
        "clearance_handling"
      ],
      "properties": {
        "not_diagnosis": { "const": true },
        "not_prescription": { "const": true },
        "emergency_route": { "type": "string", "minLength": 10 },
        "requires_clinician_clearance": { "type": "boolean" },
        "medical_functionality_disabled": { "const": true },
        "clearance_handling": { "const": "external_verifier_unavailable_fail_closed" }
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_reviewed", "safety_reviewed", "clinical_legal_reviewed"],
      "properties": {
        "evidence_reviewed": { "type": "boolean" },
        "safety_reviewed": { "type": "boolean" },
        "clinical_legal_reviewed": { "type": "boolean" }
      }
    },
    "fork_of": { "type": "string" },
    "authors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "last_reviewed": { "type": "string", "format": "date" }
  }
}
