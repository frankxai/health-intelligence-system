{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bios.health/schemas/consent.v0.1.json",
  "title": "BIOS Consent Grant",
  "description": "Per-field x recipient x purpose x revocable consent. Data, not a SaaS checkbox.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "consent_id",
    "schema_version",
    "household_id",
    "subject_id",
    "authorized_by_id",
    "authority_basis",
    "purposes",
    "data_classes",
    "recipients",
    "actions",
    "granted_at",
    "status"
  ],
  "properties": {
    "consent_id": { "type": "string", "pattern": "^consent_[A-Za-z0-9_-]+$" },
    "schema_version": { "const": "0.1.0" },
    "household_id": { "type": "string" },
    "subject_id": { "type": "string" },
    "authorized_by_id": { "type": "string" },
    "authority_basis": {
      "enum": ["self", "parental_responsibility", "legal_guardian", "authorized_representative", "steward_delegated"]
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "self_tracking",
          "family_stewardship",
          "clinician_handoff",
          "agent_assist",
          "research_contribution",
          "backup",
          "education"
        ]
      },
      "uniqueItems": true
    },
    "data_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "wellness_logs",
          "meal_photos",
          "wearable_rollups",
          "supplement_stack",
          "clinical_records_index",
          "clinical_records_content",
          "genomic",
          "identifiers",
          "protocol_outcomes_deid"
        ]
      },
      "uniqueItems": true
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipient_id", "kind"],
        "properties": {
          "recipient_id": { "type": "string" },
          "kind": {
            "enum": ["self", "steward", "household_member", "clinician", "local_agent", "frontier_model", "commons", "backup_target"]
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["collect", "store", "summarize", "ai_process", "export", "share", "contribute_deid"]
      },
      "uniqueItems": true
    },
    "field_allowlist": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional explicit fields; empty means data_classes only"
    },
    "granted_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "withdrawn_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "expired", "withdrawn", "superseded"] },
    "dignity_clause": {
      "type": "boolean",
      "description": "Subject may always read everything written about them",
      "const": true
    },
    "notice_version": { "type": "string" }
  }
}
