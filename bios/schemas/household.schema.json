{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bios.health/schemas/household.v0.1.json",
  "title": "BIOS Household",
  "description": "Canonical ownership unit. Subjects nest inside households; steward may differ from subject.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "household_id",
    "schema_version",
    "display_name",
    "subjects",
    "stewards",
    "created_at"
  ],
  "properties": {
    "household_id": { "type": "string", "pattern": "^hh_[A-Za-z0-9_-]+$" },
    "schema_version": { "const": "0.1.0" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "display_name", "role"],
        "properties": {
          "subject_id": { "type": "string", "pattern": "^sub_[A-Za-z0-9_-]+$" },
          "display_name": { "type": "string" },
          "role": {
            "enum": ["self", "partner", "child", "parent", "grandparent", "dependent", "other"]
          },
          "can_read_own": { "type": "boolean", "const": true },
          "timezone": { "type": "string" },
          "locale": { "type": "string" }
        }
      }
    },
    "stewards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator_id", "display_name", "subject_scope"],
        "properties": {
          "operator_id": { "type": "string", "pattern": "^op_[A-Za-z0-9_-]+$" },
          "display_name": { "type": "string" },
          "subject_scope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "permissions": {
            "type": "array",
            "items": {
              "enum": ["read", "write_observe", "start_protocol", "export_handoff", "manage_consent", "admin"]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
