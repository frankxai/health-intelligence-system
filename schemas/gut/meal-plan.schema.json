{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/gut/meal-plan.schema.json",
  "title": "Gut Intelligence Ordinary-Wellness Meal Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "scope", "days", "shopping_cues", "coach_questions", "disclaimer"],
  "properties": {
    "status": {"enum": ["ready_for_parent_review", "blocked", "qualified_review_required"]},
    "scope": {"const": "ordinary_wellness_meal_planning"},
    "days": {
      "type": "array",
      "minItems": 0,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "meal", "safe_base", "learning_food", "fallback", "prep_minutes"],
        "properties": {
          "day": {"type": "string"},
          "meal": {"type": "string"},
          "safe_base": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "learning_food": {"type": ["string", "null"]},
          "fallback": {"type": "string"},
          "prep_minutes": {"type": "integer", "minimum": 0, "maximum": 180}
        }
      }
    },
    "shopping_cues": {"type": "array", "items": {"type": "string"}},
    "coach_questions": {"type": "array", "items": {"type": "string"}},
    "disclaimer": {"type": "string", "minLength": 20}
  }
}
