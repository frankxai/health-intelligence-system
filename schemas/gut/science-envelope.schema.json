{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/gut/science-envelope.schema.json",
  "title": "Approved Gut Science Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_id", "adapter_version", "reviewed_at", "evidence_grade", "goals", "approved_food_categories", "excluded_claims", "human_review_required"],
  "properties": {
    "adapter_id": {"type": "string", "minLength": 3, "maxLength": 100},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "reviewed_at": {"type": "string", "format": "date"},
    "evidence_grade": {"enum": ["partner-reviewed", "clinician-reviewed"]},
    "goals": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true},
    "approved_food_categories": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true},
    "excluded_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 160}, "uniqueItems": true},
    "human_review_required": {"type": "boolean"}
  }
}
